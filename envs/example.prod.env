# Copy to the EC2 release root as .env. Values below are names/examples only.
# Do not commit the completed .env file or any model artifact.

# Compose image release
COMPOSE_PROJECT_NAME=ah05
DOCKER_USER=your-dockerhub-user
DOCKER_REPOSITORY=ah-05-02
APP_VERSION=v0.0.0
AI_WORKER_VERSION=v0.0.0

# App security
ENV=prod
SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
COOKIE_DOMAIN=your-domain.example
DEMO_MODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Private database network (no host database port is exposed)
DB_HOST=mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-long-unique-password
DB_ROOT_PASSWORD=replace-with-a-different-long-unique-password
DB_NAME=ai_health
DB_GENERATE_SCHEMAS=false

# Private Redis network (no host Redis port is exposed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM=ai:jobs
REDIS_CONSUMER_GROUP=ai-workers
REDIS_JOB_TTL_SECONDS=86400
REDIS_CLAIM_IDLE_MS=60000
AI_JOB_MAX_ATTEMPTS=3

# Approved model only. Choose exactly one source.
# Local artifact: MODEL_URI=/app/storage/models/approved-model.joblib
# Object storage: MODEL_URI=s3://bucket/path/approved-model.joblib
MODEL_URI=
MODEL_MANIFEST_URI=
CURRENT_SCREENING_MODEL_URI=/app/models/artifacts/candidates/diabetes_current_screening/knhanes-today14-sk180-service-v3/model.joblib
CURRENT_SCREENING_RUNTIME=today14
ML_SHARED8_MODEL_URI=
ML_RF25_MODEL_URI=/app/models/artifacts/candidates/diabetes_incidence/rf25-tuned-education4-v2/model.joblib
CURRENT_SCREENING_MANIFEST_URI=/app/models/registry/diabetes_current_screening/candidates/knhanes-today14-sk180-service-v3.json
MODEL_MANIFEST_URI=/app/models/registry/diabetes_incidence/candidates/rf25-tuned-education4-v2.json
MODEL_PRELOAD_ENABLED=true
PREDICTION_OPERATIONAL_MODEL_ACTIVATED=false
CURRENT_SCREENING_OPERATIONAL_MODEL_ACTIVATED=true
MODEL_CACHE_DIR=/app/storage/cache
# One-time host provisioning source; model binaries stay outside Git/images.
MODEL_DELIVERY_GOOGLE_DRIVE_FOLDER_ID=1uvxqFfcX6VZ8g4I9Fjv_az8_vWkkOb18
PREDICTION_PROVIDER=development
PREDICTION_MODEL_KEY=diabetes_incidence
PREDICTION_MODEL_VERSION=
PREDICTION_FEATURE_SCHEMA_VERSION=
PREDICTION_THRESHOLD_VERSION=
PREDICTION_MODEL_MIN_AGE=45
PREDICTION_MODEL_POPULATION=baseline_undiagnosed_age_45_plus
PREDICTION_TIMEOUT_SECONDS=30

# Required only when MODEL_URI starts with s3://
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public Google Drive K-food model bundle. Downloaded once at API startup,
# checksum-verified and installed into the private cache volume.
FOOD_VISION_PROVIDER=local_kfood
KFOOD_DRIVE_FILE_ID=1KvCX9bU9GwZvcvZSl0eYHlZ-yg4UbAjQ
KFOOD_BUNDLE_SHA256=753d7c4d3a7d9f9e074565cda0233179243466129a48830fd299a07a9bf0b96c
KFOOD_BUNDLE_DIR=/app/storage/food_vision/kfood
KFOOD_CLASSIFIER_SHA256=4c4df6ba2b9d3daf77f7ffe107285df17a360342729177d15465ba9872d42726
KFOOD_CLASSIFIER_META_SHA256=a193e1faf4e7c266e0ba4481451ded587fcd01cfc7d89c60d834bac63e14e0b3
KFOOD_SEGMENTER_SHA256=edb7df52467afd02a502d7765ca7ac82e63ad86082c72e18135764f1b1817b52
KFOOD_SEGMENTATION_CONFIG_PATH=/app/configs/food_vision/seg_config.json
KFOOD_DISH_VEGETABLES_PATH=/app/configs/food_vision/dish_vegetables.json
FOOD_COVERAGE_PASS_THRESHOLD=0.50
VEGETABLE_RATIO_PASS_THRESHOLD=0.30

# Used by the HTTPS bootstrap/renewal procedure
SERVER_NAME=your-domain.example
CERTBOT_EMAIL=team@example.com

# password reset email
FRONTEND_BASE_URL=https://example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
