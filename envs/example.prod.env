# Copy to the EC2 release root as .env. Values below are names/examples only.
# Do not commit the completed .env file or any model artifact.

# Compose image release
COMPOSE_PROJECT_NAME=ah05
DOCKER_USER=your-dockerhub-user
DOCKER_REPOSITORY=ah-05-02
APP_VERSION=v0.0.0
AI_WORKER_VERSION=v0.0.0

# App security
ENV=prod
SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
COOKIE_DOMAIN=your-domain.example
DEMO_MODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Private database network (no host database port is exposed)
DB_HOST=mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-a-long-unique-password
DB_ROOT_PASSWORD=replace-with-a-different-long-unique-password
DB_NAME=ai_health
DB_GENERATE_SCHEMAS=false

# Private Redis network (no host Redis port is exposed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM=ai:jobs
REDIS_CONSUMER_GROUP=ai-workers
REDIS_JOB_TTL_SECONDS=86400
REDIS_CLAIM_IDLE_MS=60000
AI_JOB_MAX_ATTEMPTS=3

# Approved model only. Choose exactly one source.
# Local artifact: MODEL_URI=/app/storage/models/approved-model.joblib
# Object storage: MODEL_URI=s3://bucket/path/approved-model.joblib
MODEL_URI=
MODEL_MANIFEST_URI=
CURRENT_SCREENING_MODEL_URI=
CURRENT_SCREENING_RUNTIME=v061
ML_SHARED8_MODEL_URI=
ML_RF25_MODEL_URI=
CURRENT_SCREENING_MANIFEST_URI=
MODEL_CACHE_DIR=/app/storage/cache
PREDICTION_PROVIDER=production
PREDICTION_MODEL_KEY=diabetes_incidence
PREDICTION_MODEL_VERSION=
PREDICTION_FEATURE_SCHEMA_VERSION=
PREDICTION_THRESHOLD_VERSION=
PREDICTION_MODEL_MIN_AGE=45
PREDICTION_MODEL_POPULATION=baseline_undiagnosed_age_45_plus
PREDICTION_TIMEOUT_SECONDS=30

# Required only when MODEL_URI starts with s3://
AWS_REGION=ap-northeast-2
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Used by the HTTPS bootstrap/renewal procedure
SERVER_NAME=your-domain.example
CERTBOT_EMAIL=team@example.com
